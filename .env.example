OPENROUTER_API_KEY=...
DEFAULT_KEY=...
ENCRYPTION_KEY=...
ENCRYPTION_IV=...
PUBLIC_VERSION=production

# --- Request-origin gate for /api/chat -------------------------------------
# The deployment's own origin is always allowed (the chat iframe calls its own
# API). List any EXTRA allowed origins here, comma-separated, full origins:
# e.g. https://my-preview-deployment.vercel.app
ALLOWED_REQUEST_ORIGINS=

# --- OpenRouter routing policy (server-enforced) ---------------------------
# Zero Data Retention routing: "true" (default) restricts OpenRouter requests
# to endpoints certified to store nothing. Set "false" only for studies that
# accept provider-side retention. https://openrouter.ai/docs/features/zdr
OPENROUTER_ZDR=true
# Optional endpoint pin (comma-separated). "amazon-bedrock/us" keeps inference
# on US-resident zero-retention infrastructure. Leave empty for any ZDR endpoint.
OPENROUTER_PROVIDER_ONLY=amazon-bedrock/us

# --- Transcript checkpointing (optional; /api/checkpoint) ------------------
# Relays per-message transcript snapshots into a dedicated Qualtrics survey so
# abandoned chats are still captured server-side. Leave unset to disable.
# Use a token from a RESTRICTED Qualtrics user with access to only that survey.
QUALTRICS_API_TOKEN=
QUALTRICS_DATACENTER=ca1
QUALTRICS_CHECKPOINT_SURVEY_ID=
