# --- Required for Albertsons protocol v2 -----------------------------------
# Rotate the study key before launch. It is used only on the server and the v2
# API never accepts a browser-supplied model, prompt, provider, or ciphertext.
OPENROUTER_API_KEY=<new-rotated-study-key>

# Generate at least 32 random UTF-8 bytes. Do not reuse an OpenRouter or
# Qualtrics credential. This signs 60-minute session/history state and seals
# 24-hour opaque checkpoint handles; it never enters browser configuration or
# exports. Keep it stable across deploys while sessions/handles may be active;
# rotation invalidates every outstanding token and checkpoint handle.
SESSION_SIGNING_KEY=CHANGE_ME_generate_at_least_32_random_bytes

# Exact parent origins, comma-separated and without paths. These are public
# configuration and are enforced both by postMessage validation and CSP.
# Required at production build time. Use the exact origin(s) observed in the
# published survey URL; comma-separate staging and production only when this
# deployment intentionally supports both. A conventional trailing slash is
# accepted and canonicalized.
PUBLIC_QUALTRICS_PARENT_ORIGINS=https://your-brand.example-datacenter.qualtrics.com

# Use a restricted Cornell service account that can access only the checkpoint
# survey. The datacenter value is the ID (for example ca1), not a branded host.
# Keep this false until all three values below identify the intended tenant and
# checkpoint survey; this prevents retained legacy credentials from being used
# accidentally during migration.
ENABLE_V2_CHECKPOINT=false
QUALTRICS_API_TOKEN=
QUALTRICS_DATACENTER=ca1
QUALTRICS_CHECKPOINT_SURVEY_ID=

# Legacy v1 endpoints return 410 unless this explicit migration flag is true.
# During a deliberate coexistence window, set true only while already-published
# v5 surveys still need the old routes. After all three v6 surveys pass live
# validation and replace v5 entry links, set false and verify v1 returns 410.
# The v6 app never falls back to v1 regardless of this setting.
ENABLE_LEGACY_V1=false

# --- Legacy v1 only; remove from Vercel after the v6 cutover ----------------
DEFAULT_KEY=
ENCRYPTION_KEY=
ENCRYPTION_IV=
PUBLIC_VERSION=production
ALLOWED_REQUEST_ORIGINS=
OPENROUTER_ZDR=true
OPENROUTER_PROVIDER_ONLY=amazon-bedrock/us

# --- Load testing only (loadtest/* branches; see loadtest/README.md) --------
# PROVIDER_STUB=1 answers both OpenRouter calls in-process with synthetic
# responses (zero model spend). It engages only on the Vite dev server or on
# the vaccine-chat-loadtest Vercel project; any other host refuses it and logs
# loadtest_stub_refused. Timing knobs default to the measured production
# profile. LOADTEST_INSTANCE_HEADER=1 adds the x-loadtest-instance response
# header without stubbing (same host guard).
#PROVIDER_STUB=1
#LOADTEST_INSTANCE_HEADER=1
#STUB_SCRUB_MS=750
#STUB_FIRST_BYTE_MS=2000
#STUB_STREAM_MS=6000
#STUB_ANSWER_CHARS=900
#STUB_CHUNK_MS=50
#STUB_JITTER=0.3
#STUB_ERROR_RATE=0
#STUB_RETRY_AFTER_SECONDS=1
